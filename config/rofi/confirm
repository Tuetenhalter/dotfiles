#!/usr/bin/env bash

# arg1 = prompt text
# arg2 = command to execute
# arg3 = selected entry (passed automatically by rofi on selection)

if [[ "$ROFI_RETV" == "0" ]]; then
    printf '\0prompt\x1f%s\n' "$1"
    printf 'yes\n'
    printf 'no\n'
    exit 0
fi

if [[ "$ROFI_RETV" == "1" && "$3" == "yes" ]]; then
    # Run detached in a new session so rofi doesn't wait for or kill the command
    setsid -f bash -c "$2" >/dev/null 2>&1
fi